<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MemoryOfMemorieCodexBridge</AssemblyName>
    <RootNamespace>MemoryOfMemorieCodexBridge</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <MemoryOfMemorieBepInExDirectory Condition="'$(MemoryOfMemorieBepInExDirectory)' == ''">$(MEMORY_OF_MEMORIE_BEPINEX_DIR)</MemoryOfMemorieBepInExDirectory>
    <BepInExCoreDirectory>$(MemoryOfMemorieBepInExDirectory)\core</BepInExCoreDirectory>
    <GameInteropDirectory>$(MemoryOfMemorieBepInExDirectory)\interop</GameInteropDirectory>
  </PropertyGroup>

  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(MemoryOfMemorieBepInExDirectory)' == ''" Text="Set MEMORY_OF_MEMORIE_BEPINEX_DIR to the game's BepInEx directory before building." />
    <Error Condition="!Exists('$(BepInExCoreDirectory)\BepInEx.Core.dll')" Text="BepInEx core DLLs were not found under $(BepInExCoreDirectory)." />
    <Error Condition="!Exists('$(GameInteropDirectory)\Il2Cppmscorlib.dll')" Text="Game IL2CPP interop DLLs were not found under $(GameInteropDirectory). Run the game once with BepInEx before building." />
  </Target>

  <ItemGroup>
    <Compile Remove=".trash\**\*.cs;outputs\**\*.cs;src\**\*.cs" />
    <EmbeddedResource Remove=".trash\**;outputs\**;src\**" />
    <None Remove=".trash\**;outputs\**;src\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCoreDirectory)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExCoreDirectory)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(BepInExCoreDirectory)\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCoreDirectory)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameInteropDirectory)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameInteropDirectory)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
