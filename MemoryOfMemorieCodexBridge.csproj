<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MemoryOfMemorieCodexBridge</AssemblyName>
    <RootNamespace>MemoryOfMemorieCodexBridge</RootNamespace>
    <Version>0.3.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <MemoryOfMemorieBepInExDirectory Condition="'$(MemoryOfMemorieBepInExDirectory)' == ''">$(MEMORY_OF_MEMORIE_BEPINEX_DIR)</MemoryOfMemorieBepInExDirectory>
    <BepInExCoreDirectory>$(MemoryOfMemorieBepInExDirectory)\core</BepInExCoreDirectory>
    <BuildReferencesDirectory>$(MSBuildThisFileDirectory).github\build-references\unity-6000.3.6</BuildReferencesDirectory>
  </PropertyGroup>

  <Target Name="ValidateBuildReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(MemoryOfMemorieBepInExDirectory)' == ''" Text="Set MEMORY_OF_MEMORIE_BEPINEX_DIR or MemoryOfMemorieBepInExDirectory to a compatible BepInEx runtime before building." />
    <Error Condition="!Exists('$(BepInExCoreDirectory)\BepInEx.Core.dll')" Text="BepInEx core DLLs were not found under $(BepInExCoreDirectory)." />
    <Error Condition="!Exists('$(BuildReferencesDirectory)\Il2Cppmscorlib.dll')" Text="Build reference Il2Cppmscorlib.dll was not found under $(BuildReferencesDirectory)." />
    <Error Condition="!Exists('$(BuildReferencesDirectory)\UnityEngine.CoreModule.dll')" Text="Build reference UnityEngine.CoreModule.dll was not found under $(BuildReferencesDirectory)." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCoreDirectory)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExCoreDirectory)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(BepInExCoreDirectory)\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCoreDirectory)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(BuildReferencesDirectory)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BuildReferencesDirectory)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
