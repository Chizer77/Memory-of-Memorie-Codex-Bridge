{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"__BRIDGE_ROOT__/memory-of-memorie-agent-hook.ps1\" -Event start",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__BRIDGE_ROOT__\\memory-of-memorie-agent-hook.ps1\" -Event start",
            "timeout": 5,
            "statusMessage": "Sync Memory of Memorie activity"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"__BRIDGE_ROOT__/memory-of-memorie-agent-hook.ps1\" -Event stop",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__BRIDGE_ROOT__\\memory-of-memorie-agent-hook.ps1\" -Event stop",
            "timeout": 5,
            "statusMessage": "Sync Memory of Memorie activity"
          }
        ]
      }
    ]
  }
}
